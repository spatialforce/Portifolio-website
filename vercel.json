{
  "images": {
    "sizes": [640, 1024, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 60
  },
  "rewrites": [
    { "source": "/data/(.*)", "destination": "/event-gallery/data/$1" },
    { "source": "/event-gallery/(.*)", "destination": "/event-gallery/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}